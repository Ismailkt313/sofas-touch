# Server Environment Configuration Template
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated list of exact frontend origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Configuration (use at least 32 characters in production)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=24h

# Default Seed Accounts (Admin & Data Entry)
DEFAULT_ADMIN_EMAIL=admin@softtouchsofas.com
DEFAULT_ADMIN_PASSWORD=YourAdminSecurePasswordHere!
DEFAULT_ADMIN_NAME=Admin Manager

DEFAULT_DATA_ENTRY_EMAIL=dataentry@softtouchsofas.com
DEFAULT_DATA_ENTRY_PASSWORD=YourDataEntrySecurePasswordHere!
DEFAULT_DATA_ENTRY_NAME=Data Entry Specialist

# Database Connection String
DATABASE_URL=

# Project Management Automation Thresholds
PROJECT_COST_WARNING_THRESHOLD_PERCENT=80
PROJECT_COST_CRITICAL_THRESHOLD_PERCENT=100
PROJECT_INACTIVITY_THRESHOLD_DAYS=14

# Cloudinary Centralized File and Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


